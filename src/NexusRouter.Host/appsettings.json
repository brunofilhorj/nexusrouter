{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nexusrouter-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Urls": "http://0.0.0.0:9090",

  "Metrics": {
    "ScrapeEndpointPath": "/metrics",
    "ScrapeIntervalSeconds": 15
  },

  "OpenTelemetry": {
    "SamplingRatio": 0.0,
    "OtlpEndpoint": null
  },

  "NexusRouter": {
    "Sessions": [
      {
        "SessionId": "B3-ENTRYPOINT-01",
        "Host": "127.0.0.1",
        "Port": 9876,
        "SenderCompId": "CLIENT1",
        "TargetCompId": "ENTRYPOINT-FIRM-0001",
        "FrameDecoder": "Fix44",
        "DeliveryMode": "PassThrough",
        "HeartbeatIntervalSeconds": 20,
        "LogonText": "NexusRouter",
        "PasswordEnvVar": null,
        "CancelOnDisconnectType": 0,
        "CodTimeoutWindow": null,
        "ResetSeqNumFlag": false,
        "Tls": {
          "Enabled": false,
          "CertificatePath": null,
          "CertificatePasswordEnvVar": null
        },
        "ReconnectPolicy": {
          "BaseDelayMs": 1000,
          "MaxDelayMs": 30000,
          "JitterFactor": 0.2
        },
        "Routes": [
          { "DispatcherId": "kafka-fix-raw" },
          { "DispatcherId": "fix-acceptor-01" }
        ]
      }
    ],

    "Dispatchers": [
      {
        "Id": "kafka-fix-raw",
        "Type": "Kafka",
        "BootstrapServers": "127.0.0.1:19092",
        "Topic": "fix.ordexec.raw",
        "ClientId": "nexusrouter-producer",
        "Acks": 1,
        "CursorAckMode": "OnBrokerAck",
        "SecurityProtocol": "Plaintext",
        "SaslMechanism": "None",
        "SaslUsernameEnvVar": null,
        "SaslPasswordEnvVar": null,
        "SslCaLocation": null,
        "EnableSslCertificateVerification": true,
        "ChannelCapacity": 65536,
        "PartitionStrategy": "None",
        "PartitionCount": 3
      },
      {
        "Id": "rabbitmq-fix-raw",
        "Type": "RabbitMQ",
        "Host": "127.0.0.1",
        "Port": 5672,
        "VirtualHost": "/",
        "UsernameEnvVar": "RABBITMQ_DEFAULT_USER",
        "PasswordEnvVar": "RABBITMQ_DEFAULT_PASS",
        "Exchange": "fix.orders",
        "RoutingKey": "fix.raw",
        "CursorAckMode": "OnBrokerAck",
        "ChannelCapacity": 65536,
        "PrefetchCount": 0
      },
      {
        "Id": "fix-acceptor-01",
        "Type": "FixOutbound",
        "ListenAddress": "0.0.0.0",
        "ListenPort": 6001,
        "SenderCompId": "NEXUSROUTER",
        "BeginString": "FIX.4.4",
        "AllowedSenderCompIds": [],
        "HeartBtInt": 20,
        "LogonTimeoutSeconds": 10,
        "ChannelCapacity": 4096,
        "Tls": {
          "Enabled": false,
          "CertificatePath": null,
          "CertificatePasswordEnvVar": null
        },
        "RequireClientCertificate": false,
        "AcceptRetryBaseDelayMs": 500,
        "AcceptRetryMaxDelayMs": 5000,
        "AcceptRetryJitterFactor": 0.2
      }
    ],

    "Audit": {
      "ChannelCapacity": 65536,
      "OverflowMode": "DropOldest",
      "BatchSize": 500,
      "FlushIntervalMs": 100,
      "PersistMode": "Full",
      "SampleRate": 1.0,
      "Sinks": [
        {
          "Type": "Serilog",
          "FilePath": "logs/audit-.log",
          "RollingInterval": "Day"
        }
      ]
    },

    "Clients": [],

    "SessionLog": {
      "Directory": "data/sessionlog",
      "RetentionTradingDays": 5,
      "FlushMode": "Interval",
      "FlushIntervalMs": 5000,
      "SegmentSizeMB": 256,
      "IndexSlotsPerSegment": 1000000,
      "UncleanRestartSeqMargin": 10000,
      "CatchUpIdleMs": 200,
      "SlotPublishTimeoutMs": 1000
    }
  }
}
