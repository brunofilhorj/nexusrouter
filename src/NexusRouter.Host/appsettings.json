{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nexusrouter-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Urls": "http://0.0.0.0:9090",

  "Metrics": {
    "ScrapeEndpointPath": "/metrics",
    "ScrapeIntervalSeconds": 15
  },

  "OpenTelemetry": {
    "SamplingRatio": 0.0,
    "OtlpEndpoint": null
  },

  "NexusRouter": {
    "Sessions": [
      {
        "SessionId": "B3-ENTRYPOINT-01",
        "Host": "simulador.b3.com.br",
        "Port": 3001,
        "SenderCompId": "NEXUSROUTER",
        "TargetCompId": "B3ENTRYPOINT",
        "FrameDecoder": "Fix44",
        "DeliveryMode": "PassThrough",
        "HeartbeatIntervalSeconds": 20,
        "Tls": {
          "Enabled": false,
          "CertificatePath": null,
          "CertificatePasswordEnvVar": null
        },
        "ReconnectPolicy": {
          "BaseDelayMs": 1000,
          "MaxDelayMs": 30000,
          "JitterFactor": 0.2
        },
        "Routes": [
          { "DispatcherId": "kafka-fix-raw" }
        ]
      }
    ],

    "Dispatchers": [
      {
        "Id": "kafka-fix-raw",
        "Type": "Kafka",
        "BootstrapServers": "localhost:19092",
        "Topic": "fix.ordexec.raw",
        "ClientId": "nexusrouter-producer",
        "Acks": 1,
        "SecurityProtocol": "Plaintext",
        "SaslMechanism": "None",
        "SaslUsernameEnvVar": null,
        "SaslPasswordEnvVar": null,
        "SslCaLocation": null,
        "EnableSslCertificateVerification": true,
        "ChannelCapacity": 65536,
        "PartitionStrategy": "None",
        "PartitionCount": 3
      },
      {
        "Id": "rabbitmq-fix-raw",
        "Type": "RabbitMQ",
        "Host": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "UsernameEnvVar": "RABBITMQ_DEFAULT_USER",
        "PasswordEnvVar": "RABBITMQ_DEFAULT_PASS",
        "Exchange": "fix.orders",
        "RoutingKey": "fix.raw",
        "ChannelCapacity": 65536,
        "PrefetchCount": 0
      },
      {
        "Id": "fix-acceptor-01",
        "Type": "FixOutbound",
        "ListenAddress": "0.0.0.0",
        "ListenPort": 6001,
        "SenderCompId": "NEXUSROUTER",
        "BeginString": "FIX.4.4",
        "SequenceStoreDirectory": "data/seqnum",
        "AllowedSenderCompIds": [],
        "HeartBtInt": 20,
        "LogonTimeoutSeconds": 10,
        "ChannelCapacity": 4096,
        "Tls": {
          "Enabled": false,
          "CertificatePath": null,
          "CertificatePasswordEnvVar": null
        },
        "RequireClientCertificate": false,
        "AcceptRetryBaseDelayMs": 500,
        "AcceptRetryMaxDelayMs": 5000,
        "AcceptRetryJitterFactor": 0.2
      },
      {
        "Id": "ws-acceptor-01",
        "Type": "WebSocket",
        "ListenAddress": "0.0.0.0",
        "ListenPort": 6002,
        "AllowedOrigins": [],
        "HeartbeatIntervalSeconds": 30,
        "MissedHeartbeatLimit": 3,
        "LogonTimeoutSeconds": 10,
        "MaxControlFrameBytes": 4096,
        "MaxOutboundFrameBytes": 65536,
        "MaxFields": 50,
        "SessionChannelCapacity": 4096,
        "SequenceStoreDirectory": "data/seqnum",
        "Tls": {
          "Enabled": false,
          "CertificatePath": null,
          "CertificatePasswordEnvVar": null
        },
        "ChannelCapacity": 65536
      }
    ],

    "Audit": {
      "ChannelCapacity": 65536,
      "OverflowMode": "DropOldest",
      "BatchSize": 500,
      "FlushIntervalMs": 100,
      "PersistMode": "Full",
      "SampleRate": 1.0,
      "Sinks": [
        {
          "Type": "Serilog",
          "FilePath": "logs/audit-.log",
          "RollingInterval": "Day"
        },
        {
          "Type": "Postgres",
          "Host": "localhost",
          "Port": 5432,
          "Database": "nexusrouter",
          "UsernameEnvVar": "POSTGRES_USER",
          "PasswordEnvVar": "POSTGRES_PASSWORD",
          "SslMode": "Disable",
          "CommandTimeoutSeconds": 30
        }
      ]
    },

    "Clients": [],

    "Replay": {
      "Enabled": false
    }
  }
}
