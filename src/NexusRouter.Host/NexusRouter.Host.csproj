<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Microsoft.Extensions.* e ASP.NET Core são transitivos via Microsoft.NET.Sdk.Web -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusRouter.Domain\NexusRouter.Domain.csproj" />
    <ProjectReference Include="..\NexusRouter.Ingress\NexusRouter.Ingress.csproj" />
    <ProjectReference Include="..\NexusRouter.Router\NexusRouter.Router.csproj" />
    <ProjectReference Include="..\NexusRouter.Egress\NexusRouter.Egress.csproj" />
    <ProjectReference Include="..\NexusRouter.Audit\NexusRouter.Audit.csproj" />
    <ProjectReference Include="..\NexusRouter.SessionLog\NexusRouter.SessionLog.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Habilita .NET User Secrets no desenvolvimento local. O Host usa WebApplication.CreateBuilder,
         que carrega User Secrets automaticamente quando o ambiente é Development e este Id está presente.
         User Secrets é SOMENTE para dev local — nunca para produção (ver docs/secrets.md). -->
    <UserSecretsId>nexusrouter-host-6f1c2a9e-7b3d-4e58-9f21-0c4d8e2a1b55</UserSecretsId>
  </PropertyGroup>

</Project>
