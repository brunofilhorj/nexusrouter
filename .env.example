# Copie para .env (gitignored) antes de `docker compose up`.
# NexusRouter lê os mesmos nomes via IConfiguration / variáveis de ambiente.

# PostgreSQL / TimescaleDB
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexusrouter
NEXUS_PG_USER=nexus
NEXUS_PG_PASSWORD=nexus

# RabbitMQ
RABBITMQ_DEFAULT_USER=nexus
RABBITMQ_DEFAULT_PASS=nexus

# Kafka SASL (somente se SecurityProtocol != Plaintext)
# NEXUS_KAFKA_SASL_USERNAME=
# NEXUS_KAFKA_SASL_PASSWORD=
