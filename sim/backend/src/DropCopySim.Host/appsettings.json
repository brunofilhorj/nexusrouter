{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dropcopysim-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "DropCopySim": {
    "Acceptor": {
      "ListenAddress": "0.0.0.0",
      "ListenPort": 9876,
      "BeginString": "FIX.4.4",
      "SenderCompId": "ENTRYPOINT-FIRM-0001",
      "TargetCompId": "CLIENT1",
      "HeartBtIntSeconds": 20,
      "LogonMode": "Success",
      "Tls": {
        "Enabled": false,
        "CertificatePath": "",
        "CertificatePasswordEnvVar": "SIM_CERT_PWD"
      }
    },
    "Simulation": {
      "TotalOrders": 0,
      "RatePerSecond": 10,
      "Accounts": ["ACC001", "ACC002", "ACC003"],
      "AccountSelection": "RoundRobin",
      "Instruments": [
        {
          "SecurityId": 200001,
          "Symbol": "PETR4",
          "SecurityExchange": "BVMF"
        },
        {
          "SecurityId": 200002,
          "Symbol": "VALE3",
          "SecurityExchange": "BVMF"
        }
      ],
      "Outcome": {
        "FillPct": 70,
        "PartialFillPct": 20,
        "CanceledPct": 7,
        "RejectedPct": 3
      },
      "PartialFillsMax": 3,
      "TestMessageIndicator": true,
      "EnabledMessageTypes": ["8"]
    },
    "Control": {
      "HttpPort": 8099,
      "AllowedOrigins": ["http://localhost:5173"],
      "AuthTokenEnvVar": "SIM_CONTROL_TOKEN"
    },
    "Telemetry": {
      "TelemetryChannelCapacity": 4096,
      "MessageSampleMaxPerSecond": 50,
      "CountersIntervalMs": 500
    }
  }
}
